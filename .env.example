SEC_USER_AGENT=            # your name and contact email, per SEC requirements
FINNHUB_API=
NEWSDATA_API=
FRED_API=
CLAUDE_CODE_OAUTH_TOKEN=   # from `claude setup-token`; optional on a laptop already logged in to Claude Code. Never set ANTHROPIC_API_KEY (it would bill the API)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=                 # the Gmail address that sends
SMTP_PASSWORD=             # Gmail app password (Google Account -> Security -> App passwords), 16 characters
DIGEST_TO=                 # where the digest goes (can be the same Gmail)
LOG_LEVEL=INFO
